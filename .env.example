# -----------------------------------------------------------------------------
# Recepção — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no provedor de hospedagem.
# NENHUMA destas variáveis é enviada ao navegador: todo acesso ao Supabase é
# feito no servidor (por isso não há prefixo NEXT_PUBLIC_).
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (ou a "anon" legada).
# Usada nas requisições em nome do usuário logado; o RLS limita o que ela acessa.
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → "Secret key" (ou "service_role" legada).
# SECRETA. Ignora o RLS. Usada apenas no servidor, em ações já verificadas como
# de gestor (criar usuário, redefinir senha, bloquear acesso). Nunca exponha.
SUPABASE_SECRET_KEY=

# Fuso horário usado nos indicadores e nas datas exibidas.
APP_TIMEZONE=America/Sao_Paulo
